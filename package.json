{
  "name": "@beezzonline/paperclip-plugin-github-sync",
  "version": "0.1.0",
  "description": "Bidirectional GitHub issue sync plugin for Paperclip — assign tasks to AI agents via labels, sync statuses, and let agents open PRs",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "github",
    "sync",
    "ai-agents",
    "issue-tracking",
    "automation"
  ],
  "author": "Beezzonline <https://github.com/BeezzonlineLab>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeezzonlineLab/paperclip-plugin-github-sync.git"
  },
  "homepage": "https://github.com/BeezzonlineLab/paperclip-plugin-github-sync#readme",
  "bugs": {
    "url": "https://github.com/BeezzonlineLab/paperclip-plugin-github-sync/issues"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "^1.0.0",
    "@paperclipai/shared": "^0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
